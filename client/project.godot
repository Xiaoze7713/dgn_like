;   param=value ; assign values to parameters

config_version=5

[application]

config/name="dnf_like"
run/main_scene="res://scenes/world.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Env="*res://core/app_env.gd"
Log="*res://core/log/log.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=1000
window/size/window_width_override=1600
window/size/window_height_override=1000
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="dnf_like"

[npk]

latest_dir="/mnt/d/WeGameApps/rail_apps/地下城与勇士：创新世纪(1)/ImagePacks2"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

