; Godot 4.7.2 冒烟工程（仅用于环境验证，不是游戏代码）
; 验证点：能否启动 / 渲染后端 / 离屏取图 / 中文字体（默认 vs msyh.ttc vs SystemFont）
config_version=5

[application]

config/name="godot-env-smoke"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon64.png"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=640
window/size/window_height_override=360

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
